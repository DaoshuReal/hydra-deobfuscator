<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>HydraDeobfuscator</AssemblyName>
    <RootNamespace>HydraDeobfuscator</RootNamespace>
    <Version>1.0.0</Version>
    <Description>Modular deobfuscator for Hydra-protected .NET assemblies</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="dnlib" Version="4.3.0" />
  </ItemGroup>

</Project>
